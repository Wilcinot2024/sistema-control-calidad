# Exporta estas variables en el entorno; Django no carga este archivo automáticamente.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_PASSWORD=

# Recepción: IMAP TLS. Usa contraseña de aplicación o token OAuth vigente.
SDI_IMAP_HOST=
SDI_IMAP_USER=
SDI_IMAP_PASSWORD=
SDI_IMAP_OAUTH_TOKEN=
SDI_IMAP_FOLDER=INBOX
SDI_ALLOWED_SENDERS=

# Consola: no entrega correos ni marca avisos como enviados.
# Al definir proveedor: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=calidad@localhost
